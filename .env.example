# =============================================================
#  Copy this file to `.env` and fill in your own keys.
#  `.env` is git-ignored so your secrets are never committed.
# =============================================================

# --- OpenAI (LLM + embeddings) — required ---
# Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- LangSmith observability (Section 8) — optional but graded ---
# Create a free key at https://smith.langchain.com (Settings -> API Keys)
# Leave blank to skip tracing; the notebook enables it automatically when set.
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=daico-navigator
